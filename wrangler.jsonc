{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taiwan-cycling-planner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "taiwan.jacobwisniewski.dev",
      "custom_domain": true
    }
  ]
}
